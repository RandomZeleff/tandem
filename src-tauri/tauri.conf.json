{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tandem",
  "version": "0.1.0",
  "identifier": "dev.tandem.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tandem",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": false,
        "center": true,
        "backgroundColor": "#111316"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Zeleff",
    "copyright": "© 2026 Zeleff — MIT",
    "category": "Game",
    "shortDescription": "Launcher Minecraft rapide, pensé pour le solo et le jeu à deux",
    "longDescription": "Tandem installe et lance Minecraft: Java Edition, ses mods et ses modpacks (Fabric, Quilt, Forge, NeoForge) depuis Modrinth, avec gestion des mondes, des sauvegardes, des captures et de la mémoire.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}